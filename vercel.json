{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/notes", "destination": "/index.html" },
    { "source": "/admin/notes", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/desk", "destination": "/index.html" },
    { "source": "/playtime", "destination": "/index.html" },
    { "source": "/:legacyAgents([aA][gG][eE][nN][tT][sS])", "destination": "/index.html" },
    { "source": "/work/atlas-brand", "destination": "/work/atlas-brand/index.html" },
    { "source": "/work/adhikar-brand", "destination": "/work/adhikar-brand/index.html" },
    { "source": "/work/:path*", "destination": "/index.html" }
  ]
}
