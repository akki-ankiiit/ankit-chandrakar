# Server secrets only. Copy to an ignored .env.local for local serving.
# Never expose these through VITE_* or the browser.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted functions.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.example
SITE_URL=https://your-production-domain.example
APP_ENV=production
TURNSTILE_SECRET_KEY=replace-with-server-side-turnstile-secret
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,your-production-domain.example
LOCAL_CAPTCHA_BYPASS=false
IP_HASH_SECRET=replace-with-at-least-32-random-secret-characters
# EXAMPLE ONLY: verify your gateway's overwritten/appended header and index.
# Never trust an attacker-supplied forwarding header. See README.md.
TRUSTED_IP_HEADER=x-forwarded-for
TRUSTED_IP_INDEX=-1
RESEND_API_KEY=replace-with-resend-server-api-key
RESEND_FROM_EMAIL=Portfolio <notifications@your-verified-domain.example>
OWNER_EMAIL=chandrakarankit014@gmail.com
